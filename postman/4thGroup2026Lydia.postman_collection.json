              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Verify user role is admin\", function() {\r",
                  "      let response = pm.response.json();\r",
                  "      pm.expect(response.data.user.role).to.eql(\"admin\");\r",
                  "});\r",
                  "\r",
                  "//Convert response to json\r",
                  "let response = pm.response.json();\r",
                  "\r",
                  "// Extracting a token \r",
                  "\r",
                  "let token = response.data.token;\r",
                  "\r",
                  "\r",
                  "//Save token to environment variable \r",
                  "pm.environment.set(\"token\",token);\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
